classDiagram
    direction LR

    %% ==================== 数据模型（api / core） ====================
    class AccountView {
        +number id
        +string uuid
        +string name
        +string display_name
        +AccountType type
        +string icon
        +string color
        +string parent_uuid
        +string commodity_restriction
        +string close_date
        +number sort_order
        +Record~string,string~ balances
    }
    note for AccountView "name = ASCII 导出名（Expenses:Food）；display_name = 中文 DisplayName；真实数据源 = accountApi.list()"

    class CommodityView {
        +string symbol
        +string name
        +number precision
        +boolean used
        +boolean is_default
    }

    class RecordForm {
        +RecordKind kind
        +string amountExpression
        +string date
        +TxnFlag flag
        +string description
        +string[] tags
        +number categoryAccountId
        +number fundAccountId
        +number transferFromAccountId
        +number transferToAccountId
    }
    note for RecordForm "新增 flag: '*' 已完成 / '!' 待核；随草稿持久化（core/storage）"

    class AdvancedRow {
        +number accountId
        +string amount
        +string commodity
    }

    class PostingDraft {
        +number accountId
        +string accountName
        +string commodity
        +string amount
    }

    class PostingView {
        +AccountView account
        +string name
        +string label
        +string amount
        +string commodity
        +boolean isDebit
    }
    note for PostingView "name 取 account.name（真实导出名）；label 取 display_name；isDebit = amount > 0（仅 UI 徽标，Beancount 无借贷字段）"

    class BalanceGroup {
        +string commodity
        +string sum
        +string pos
        +string neg
        +number rows
        +boolean balanced
    }

    class BeanSnippet {
        +string date
        +TxnFlag flag
        +string description
        +string tagsMeta
        +string[] postingLines
        +toString() string
    }
    note for BeanSnippet "逐字对齐 internal/export/beancount.go：date flag \"desc\" + tags: \"...\" + 账户 金额 币种；金额禁止千分位"

    class ReceiptSnapshot {
        +string stamp
        +string stampSub
        +string tone
        +string kindLabel
        +string amount
        +string commodity
        +ReceiptRow[] rows
        +ReceiptPosting[] postings
        +string bean
        +string[] footLines
        +string statusLine
    }

    %% ==================== 服务 / 纯函数层 ====================
    class CoreRecord {
        <<module: core/record.ts>>
        +accountLabel(a) string
        +buildPostings(form, accounts, defaultCommodity) PostingDraft[]
        +evaluateAmountExpression(expr) Money
        +balanceDiffByCommodity(postings) Diff[]
        +balanceGroups(postings) BalanceGroup[]
        +buildPostingViews(postings, accounts) PostingView[]
        +resolveAccountCommodity(a, fallback) string
        +todayString() string
    }

    class CoreBean {
        <<module: core/bean.ts (新增)>>
        +beanAmount(amount) string
        +joinTags(tags) string
        +buildBeanSnippet(input) string
    }
    note for CoreBean "纯函数：无 DOM / 无 Vue 依赖；金额复用 core/Money.toString()（定点两位、无指数、无千分位）"

    class CoreStorage {
        <<module: core/storage.ts>>
        +readDraft(ledgerId) Object
        +writeDraft(ledgerId, form) void
        +clearDraft(ledgerId) void
        +readDefaultAccounts(ledgerId) Object
        +setDefaultAccount(ledgerId, kind, uuid) void
    }

    class ApiClient {
        <<module: api/client.ts>>
        +accountApi.list() AccountListResponse
        +commodityApi.list() CommodityListResponse
        +transactionApi.create(payload, key) TransactionCreateResult
        +transactionApi.update(uuid, payload) TransactionUpdated
        +newIdempotencyKey() string
    }

    class Money {
        <<module: core/Money.ts>>
        +from(s) Money
        +zero() Money
        +toString() string
        +formatAmount() string
        +plus(other) Money
        +minus(other) Money
        +abs() Money
        +negated() Money
    }

    %% ==================== 状态层 ====================
    class SessionStore {
        <<pinia>>
        +number ledgerId
        +boolean isViewer
        +string defaultCommodity
        +string ledgerName
    }
    class RecordSheetStore {
        <<pinia>>
        +boolean isOpen
        +number savedEpoch
        +TransactionView editingTxn
        +open() void
        +openEdit(txn) void
        +close() void
        +notifySaved(result) void
        +notifyChanged() void
    }

    %% ==================== 组件 ====================
    class RecordSheet {
        <<Vue SFC>>
        +string variant
        +accounts AccountView[]
        +commodities CommodityView[]
        +form RecordForm
        +rows AdvancedRow[]
        +boolean advancedMode
        +boolean showSuccess
        +ReceiptSnapshot receipt
        +string vvh
        +boolean kbdOpen
        +preview PostingView[]
        +balanceGroups BalanceGroup[]
        +canSubmit boolean
        +loadAccounts() Promise
        +loadCommodities() Promise
        +switchKind(kind) void
        +pressKey(key) void
        +selectCategory(id) void
        +toggleAdvanced() void
        +autoBalance() void
        +addRow() void
        +removeRow(i) void
        +submit(continueAfter) Promise
        +saveOffline(payload) Promise~string~
        +buildReceipt(mode, payload, uuid) ReceiptSnapshot
        +syncVv() void
        +resetForm() void
    }

    class PostingPreview {
        <<Vue SFC 新增>>
        +PostingView[] postings
        +BalanceGroup[] groups
        +string bean
        +boolean advanced
    }
    class AdvancedPostings {
        <<Vue SFC 新增>>
        +AdvancedRow[] rows
        +AccountView[] accounts
        +string[] commodities
        +BalanceGroup[] groups
        +addRow() void
        +removeRow(i) void
        +autoBalance() void
        +onAccountChange(i, id) void
        +onAmountChange(i, value) void
    }
    class ReceiptSlip {
        <<Vue SFC 改>>
        +string stamp
        +string tone
        +string amount
        +ReceiptPosting[] postings
        +string bean
        +string thanks
    }

    %% ==================== 关系 ====================
    RecordSheet --> RecordForm : owns
    RecordSheet --> AdvancedRow : owns (0..n)
    RecordSheet --> PostingView : derives via CoreRecord
    RecordSheet --> BalanceGroup : derives via CoreRecord
    RecordSheet --> ReceiptSnapshot : builds on submit
    RecordSheet --> BeanSnippet : preview via CoreBean
    RecordSheet ..> PostingPreview : renders
    RecordSheet ..> AdvancedPostings : renders (advanced only)
    RecordSheet ..> ReceiptSlip : renders (success only)
    RecordSheet --> RecordSheetStore : isOpen / editingTxn
    RecordSheet --> SessionStore : ledgerId / defaultCommodity
    RecordSheet ..> ApiClient : load / submit
    RecordSheet ..> CoreStorage : draft / defaults
    RecordSheet ..> CoreBean : buildBeanSnippet
    RecordSheet ..> CoreRecord : buildPostings / balanceGroups

    PostingPreview "1" *-- "0..n" PostingView
    PostingPreview "1" *-- "0..n" BalanceGroup
    AdvancedPostings "1" *-- "0..n" AdvancedRow
    ReceiptSlip "1" <-- "1" ReceiptSnapshot

    PostingView --> AccountView : name + display_name
    AdvancedRow --> AccountView : accountId
    AdvancedRow ..> CommodityView : commodity
    ReceiptSnapshot "1" *-- "0..n" ReceiptPosting

    CoreRecord ..> Money : 定点运算
    CoreBean ..> Money : beanAmount
    CoreRecord ..> AccountView : 只读
    CoreBean ..> PostingDraft : 只读
